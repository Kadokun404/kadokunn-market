# Neon: pakai host "-pooler" untuk runtime serverless, dan host direct untuk migrasi.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

GOPAY_GATEWAY_URL="https://payment-kadokunsh.vercel.app"
GOPAY_INTERNAL_TOKEN=""

# Admin (jangan commit .env asli)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
# Minimal 32 karakter acak, contoh: openssl rand -hex 32
SESSION_SECRET=""

NEXT_PUBLIC_SHOP_NAME="Kadokunn Market"
NEXT_PUBLIC_SITE_URL="https://market.kadokunn.com"

# Rahasia untuk /api/cron/sync (cek pembayaran terjadwal), contoh: openssl rand -hex 24
CRON_SECRET=""
